{
  "name": "@flare-alert/detector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "node --watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "node --test \"dist/**/*.test.js\"",
    "verify": "node dist/verify.js",
    "keys": "node dist/vapid-keys.js"
  },
  "dependencies": {
    "@flare-alert/core": "workspace:*",
    "@supabase/supabase-js": "^2.110.9",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "typescript": "5.9.3"
  }
}
