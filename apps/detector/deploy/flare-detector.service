# systemd 유닛. Oracle Cloud VM 등 일반 리눅스 서버용.
#
# 설치:
#   sudo cp flare-detector.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now flare-detector
#
# 로그:
#   journalctl -u flare-detector -f
#
# 이 파일이 하는 일은 하나다 — 프로세스가 죽어도 다시 띄우고, 서버가
# 재부팅되어도 자동으로 올라오게 하는 것. detector는 상시 프로세스라
# 사람이 없는 새벽에 죽으면 아침까지 알림이 통째로 멈춘다.

[Unit]
Description=Flare Alert detector
Documentation=https://github.com/kzerowo/Flare_Alert
# 네트워크가 준비된 뒤에 뜬다. 안 그러면 부팅 직후 바이낸스 접속에 실패하고
# 재시작 루프를 몇 번 돈다.
After=network-online.target
Wants=network-online.target

# 재시작 폭주 제한은 [Unit]에 둔다. [Service]에 쓰면 systemd가
# "Unknown key name"으로 무시해서, 제한이 걸린 줄 알지만 실제로는
# 아무 제한 없이 무한 재시작한다.
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=flare
WorkingDirectory=/opt/flare-alert

# 환경변수는 파일로 준다. 여기 직접 쓰면 systemctl show로 키가 노출된다.
# 이 파일은 반드시 chmod 600 으로 두어야 한다 (service_role 키가 들어 있다).
EnvironmentFile=/opt/flare-alert/.env

ExecStart=/usr/bin/node /opt/flare-alert/apps/detector/dist/index.js

# 어떤 이유로 죽든 다시 띄운다.
Restart=always
RestartSec=5

# 로그는 journald가 받는다. 파일로 직접 쓰면 로테이션을 따로 해야 한다.
StandardOutput=journal
StandardError=journal
SyslogIdentifier=flare-detector

# --- 최소 권한 ---
# detector는 자기 디렉터리만 읽으면 되고 아무 데도 쓰지 않는다.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/flare-alert
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
