# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# --- detector ---

# 바이낸스 aggTrade 스트림 엔드포인트. 기본값을 쓰려면 비워둬도 된다.
# USD-M 선물(무기한)이다. 현물이 아니다 — 트레이더가 보는 차트가 선물이고,
# 같은 종목이라도 두 시장의 거래대금 분포가 다르다.
BINANCE_WS_URL=wss://fstream.binance.com/ws

# 감시할 종목 (쉼표 구분). Supabase가 연결되면 채널에서 읽으므로 무시된다.
# 비워 두면 BTCUSDT,ETHUSDT,SOLUSDT를 본다.
DETECTOR_SYMBOLS=

# 웹 푸시 서명 키(VAPID).
#
# `pnpm --filter @flare-alert/detector keys` 로 한 번 만들어 넣는다.
# 공개 키는 apps/web/.env.local의 NEXT_PUBLIC_VAPID_PUBLIC_KEY와 같아야 한다.
# 키를 바꾸면 기존 구독이 전부 무효가 되어 모두가 알림을 다시 켜야 한다.
#
# 비워 두면 알림이 콘솔로만 나간다. 오류는 아니다.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: 또는 https:// 로 시작해야 한다. 푸시 서비스가 형식을 검사한다.
VAPID_SUBJECT=mailto:you@example.com

# 헬스체크 HTTP 포트
PORT=8080

# debug | info | warn | error
LOG_LEVEL=info

# --- web ---
#
# Next.js는 apps/web/.env.local 을 읽는다. 루트의 .env가 아니다.
# 이 두 줄은 그쪽에도 넣어야 개발 서버에서 회원 기능이 켜진다.

# 브라우저에 노출되는 값이므로 비밀은 넣지 않는다.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 웹 푸시 공개 키. 위 VAPID_PUBLIC_KEY와 같은 값을 넣는다.
# 공개 키라 노출되어도 문제없다 — 이 키만으로는 알림을 보낼 수 없다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# --- Supabase ---
#
# 대시보드 > Project Settings > API 에서 가져온다.
# 비워 두면 회원 기능이 꺼지고 게스트 전용으로 동작한다. 오류는 나지 않는다.
#
# anon 키는 브라우저로 나가는 공개 값이다. 실제 보호는 행 수준 보안이
# 하므로(supabase/migrations/0001_init.sql) 노출 자체는 문제가 아니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# detector가 쓰는 접속 정보. 웹의 NEXT_PUBLIC_SUPABASE_URL과 같은 값이다.
# 둘 다 비워 두면 detector가 독립 모드로 돌아 DETECTOR_SYMBOLS만 본다.
SUPABASE_URL=

# service_role 키는 행 수준 보안을 통째로 우회한다.
# detector가 모든 사용자의 채널을 읽을 때만 쓴다.
# NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다. 붙는 순간 브라우저로 나간다.
SUPABASE_SERVICE_ROLE_KEY=
