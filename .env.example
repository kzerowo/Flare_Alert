# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다.

# --- detector ---

# 텔레그램 봇 토큰 (@BotFather에서 발급)
TELEGRAM_BOT_TOKEN=

# 바이낸스 aggTrade 스트림 엔드포인트. 기본값을 쓰려면 비워둬도 된다.
BINANCE_WS_URL=wss://stream.binance.com:9443/ws

# 헬스체크 HTTP 포트
PORT=8080

# debug | info | warn | error
LOG_LEVEL=info

# --- web ---
#
# Next.js는 apps/web/.env.local 을 읽는다. 루트의 .env가 아니다.
# 이 두 줄은 그쪽에도 넣어야 개발 서버에서 회원 기능이 켜진다.

# 브라우저에 노출되는 값이므로 비밀은 넣지 않는다.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
#
# 대시보드 > Project Settings > API 에서 가져온다.
# 비워 두면 회원 기능이 꺼지고 게스트 전용으로 동작한다. 오류는 나지 않는다.
#
# anon 키는 브라우저로 나가는 공개 값이다. 실제 보호는 행 수준 보안이
# 하므로(supabase/migrations/0001_init.sql) 노출 자체는 문제가 아니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role 키는 행 수준 보안을 통째로 우회한다.
# detector가 모든 사용자의 채널을 읽을 때만 쓴다.
# NEXT_PUBLIC_ 접두사를 절대 붙이지 않는다. 붙는 순간 브라우저로 나간다.
SUPABASE_SERVICE_ROLE_KEY=
